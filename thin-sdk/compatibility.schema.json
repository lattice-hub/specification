{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pole:thin-sdk:compatibility:1:schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contracts"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "contract_version",
          "envelope_version",
          "status",
          "verification_policy",
          "verified_combinations"
        ],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "contract_version": {"type": "string", "minLength": 1},
          "envelope_version": {"type": "string", "minLength": 1},
          "status": {"enum": ["defined", "verified", "retired"]},
          "verification_policy": {"type": "string", "minLength": 1},
          "verified_combinations": {
            "type": "array",
            "items": {"$ref": "#/$defs/verifiedCombination"}
          }
        }
      }
    }
  },
  "$defs": {
    "verifiedCombination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sidecar_version",
        "sdk_language",
        "sdk_version",
        "evidence"
      ],
      "properties": {
        "sidecar_version": {"type": "string", "minLength": 1},
        "sdk_language": {"enum": ["java", "nodejs", "python", "go"]},
        "sdk_version": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "specification_commit",
            "sidecar_commit",
            "sdk_commit",
            "ci_url"
          ],
          "properties": {
            "specification_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sidecar_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "sdk_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "ci_url": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
